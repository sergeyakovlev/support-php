{
    "authors": [
        {
            "name": "Serge Yakovlev",
            "email": "serge.yakovlev@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SergeYakovlev\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SergeYakovlev\\Support\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "sort-packages": true
    },
    "description": "Support package",
    "homepage": "https://github.com/sergeyakovlev/support-php",
    "keywords": [
        "array",
        "number",
        "php",
        "support",
        "tools",
        "utils"
    ],
    "license": "MIT",
    "name": "sergeyakovlev/support",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.46",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^13.1.0",
        "rector/jack": "^0.5.1",
        "rector/rector": "^2.4.0",
        "symplify/easy-coding-standard": "^13.0.4",
        "symplify/phpstan-rules": "^14.9.11"
    },
    "scripts": {
        "cs": "vendor/bin/ecs check --ansi",
        "cs:fix": "vendor/bin/ecs check --ansi --fix",
        "qa": [
            "@rector",
            "@cs",
            "@stan",
            "@test"
        ],
        "qa:fix": [
            "@rector:fix",
            "@cs:fix",
            "@stan",
            "@test"
        ],
        "rector": "vendor/bin/rector process --ansi --dry-run",
        "rector:fix": "vendor/bin/rector process --ansi --clear-cache",
        "stan": "vendor/bin/phpstan analyze --ansi",
        "test": "vendor/bin/phpunit"
    },
    "type": "library"
}
